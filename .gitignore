# Flutter app (remote-android/): build output and tooling caches. The Dart sources, the Android
# project files and the lockfile are tracked; everything here is regenerated by `flutter pub get`
# and `flutter build`.
/remote-android/build/
/remote-android/.dart_tool/
/remote-android/.flutter-plugins
/remote-android/.flutter-plugins-dependencies
/remote-android/.idea/
/remote-android/android/.gradle/
/remote-android/android/local.properties
/remote-android/android/app/debug/
/remote-android/android/app/profile/
/remote-android/android/app/release/

