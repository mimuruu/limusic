<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is allowed only for the addresses a home LAN actually uses, rather than globally.
  Limusic's remote API is plain HTTP by design (see remote.rs: TLS on a home LAN buys a warning,
  not privacy), but that is no reason to let this app talk HTTP to anything on the internet.

  RFC 1918 private ranges + loopback + the CGNAT range some ISPs use for home routers. Anyone
  running Limusic on a public address is on their own; they would need to add it here.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.0.0/8</domain>
        <domain includeSubdomains="false">172.16.0.0/12</domain>
        <domain includeSubdomains="false">192.168.0.0/16</domain>
        <domain includeSubdomains="false">100.64.0.0/10</domain>
        <!-- mDNS names on typical home routers, so a hostname works as well as an IP. -->
        <domain includeSubdomains="true">local</domain>
    </domain-config>
</network-security-config>
